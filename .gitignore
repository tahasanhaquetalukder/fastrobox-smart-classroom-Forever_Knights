# --- Secrets / environment (never commit real values) ---
.env
.env.*
!.env.example
*.env
backend/.env
firmware/secrets.h
firmware/src/secrets.h
**/secrets.*

# --- Node / backend ---
node_modules/
backend/node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
*.log
coverage/

# --- Device simulator runtime spool (never commit) ---
tools/simulator/spool.jsonl
*.spool

# --- Database exports (schema migrations in backend/ ARE committed) ---
backups/
*.dump
*.backup
*.pgdump
*.sqlite
*.sqlite3
*.sql.gz

