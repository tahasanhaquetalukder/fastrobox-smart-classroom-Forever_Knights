# ============================================================================
# EXAMPLE ONLY — copy to `.env` and fill in real values.
# `.env` is gitignored. NEVER commit real secrets. On Render, set these in the
# service Environment tab (or let render.yaml generate them) instead of a file.
# ============================================================================

# --- Backend server ---
PORT=3000
NODE_ENV=development

# --- PostgreSQL ---
# Local example (replace USER/PASSWORD/HOST/DBNAME with your own):
DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/DBNAME
# SSL is auto-detected from the DATABASE_URL host: enabled for any non-localhost
# host (Render EXTERNAL url requires it), disabled for localhost/127.0.0.1.
# Override only when needed:
#   DATABASE_SSL=true   -> force SSL (rejectUnauthorized:false)
#   DATABASE_SSL=false  -> force no SSL (e.g. Render INTERNAL url from render.yaml)
# Leave blank to use auto-detection.
DATABASE_SSL=

# --- Device authentication ---
# Prefer per-device tokens issued through POST /api/devices or seed:device.
# Shared bootstrap is disabled unless BOTH values below are configured. It also
# requires X-Device-Id and a roomId (or DEFAULT_ROOM_ID) on the first request.
# DEVICE_TOKEN is a SECRET. Never commit a real value.
DEVICE_BOOTSTRAP_ENABLED=false
DEVICE_TOKEN=

# --- Required admin authentication for every dashboard mutation ---
# The dashboard sends this as `X-Admin-Token`. If blank, mutations return 503.
# Use a long random string. This is a SECRET.
ADMIN_TOKEN=

# --- Protected read access (history, attendance, door, settings and SSE) ---
# READ_TOKEN grants read-only access; ADMIN_TOKEN also grants read access.
# At least one must be configured or protected reads return 503. SECRET.
READ_TOKEN=

# Per-IP fixed-window limits. Device telemetry counts as writes.
AUTH_FAILURE_LIMIT=10
WRITE_LIMIT=120
RATE_LIMIT_WINDOW_MS=60000

# --- Default room id (seed only; runtime-editable via dashboard /api/settings) ---
DEFAULT_ROOM_ID=ROOM-1