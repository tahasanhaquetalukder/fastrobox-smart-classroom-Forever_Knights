# ============================================================================
# EXAMPLE ONLY — copy to `.env` and fill in real values.
# `.env` is gitignored. NEVER commit real secrets. On Render, set these in the
# service Environment tab (or let render.yaml generate them) instead of a file.
# ============================================================================

# --- Backend server ---
PORT=3000
NODE_ENV=development

# --- PostgreSQL ---
# Local example (replace USER/PASSWORD/HOST/DBNAME with your own):
DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/DBNAME
# Set to "true" only when the DB requires SSL (e.g. Render EXTERNAL url).
# Render INTERNAL url (from render.yaml) does not need SSL -> leave "false".
PGSSL=false

# --- Device authentication ---
# Optional shared bootstrap token. A device presenting this token is accepted
# and auto-registered. Per-device tokens can also be stored (hashed) in the DB
# via `npm run seed:device`. Leave blank to require DB-issued tokens only.
# Use a long random string. This is a SECRET.
DEVICE_TOKEN=

# --- Optional admin guard for mutating dashboard routes (settings/door) ---
# If set, the dashboard must send this as `X-Admin-Token` (there is a field for
# it in the UI). Leave blank to disable the guard for the live demo. SECRET.
ADMIN_TOKEN=

# --- Default room id (seed only; runtime-editable via dashboard /api/settings) ---
DEFAULT_ROOM_ID=ROOM-1