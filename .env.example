# ============================================================================
# EXAMPLE ONLY — copy to `.env` and fill in real values.
# `.env` is gitignored. NEVER commit real secrets. On Render, set these in the
# service Environment tab (or let render.yaml generate them) instead of a file.
# ============================================================================

# --- Backend server ---
PORT=3000
NODE_ENV=development

# --- PostgreSQL ---
# Local example (replace USER/PASSWORD/HOST/DBNAME with your own):
DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/DBNAME
# SSL is auto-detected from the DATABASE_URL host: enabled for any non-localhost
# host (Render EXTERNAL url requires it), disabled for localhost/127.0.0.1.
# Override only when needed:
#   DATABASE_SSL=true   -> force SSL (rejectUnauthorized:false)
#   DATABASE_SSL=false  -> force no SSL (e.g. Render INTERNAL url from render.yaml)
# Leave blank to use auto-detection.
DATABASE_SSL=

# --- Device authentication ---
# Prefer per-device tokens issued through POST /api/devices or `npm run seed:device`.
# Shared bootstrap is disabled unless BOTH values below are configured. It also
# requires X-Device-Id and a roomId (or DEFAULT_ROOM_ID) on the first request.
# DEVICE_TOKEN is a SECRET. Never commit a real value.
DEVICE_BOOTSTRAP_ENABLED=false
DEVICE_TOKEN=

# --- Accounts, sessions and lockout (Level 4) ---
# Passwords are bcrypt hashes in the database; no password is stored in git.
# `npm run seed:users` creates the judge accounts. Set the password variables to
# choose credentials; any variable left blank generates a random password and
# prints it once.
ADMIN_EMAIL=admin@smartclass.local
ADMIN_PASSWORD=
ADMIN_NAME=Admin
TEACHER_EMAIL=teacher@smartclass.local
TEACHER_PASSWORD=
TEACHER_NAME=Teacher
TEACHER_CLASS=Class 8-A
STUDENT1_EMAIL=student1@smartclass.local
STUDENT1_PASSWORD=
STUDENT1_NAME=Student S1
STUDENT1_CLASS=Class 8-A
STUDENT2_EMAIL=student2@smartclass.local
STUDENT2_PASSWORD=
STUDENT2_NAME=Student S2
STUDENT2_CLASS=Class 8-A
GUARDIAN_EMAIL=guardian@smartclass.local
GUARDIAN_PASSWORD=
GUARDIAN_NAME=Guardian of S1
# Optional card UIDs to bind during seeding (hex, no separators).
TEACHER_CARD_UID=
STUDENT1_CARD_UID=
STUDENT2_CARD_UID=

# 5 wrong passwords lock the account. A correct password does not bypass an
# active lock; the check happens before password comparison.
LOGIN_MAX_FAILURES=5
LOGIN_LOCK_MS=30000
BCRYPT_ROUNDS=10
SESSION_TTL_HOURS=12

# --- Legacy protected access (optional; retained for scripts/judges) ---
# User sessions are the primary dashboard auth. These tokens still work for
# the operator endpoints and fail closed when unset.
# ADMIN_TOKEN is a SECRET. READ_TOKEN grants read-only access.
ADMIN_TOKEN=
# Leave READ_TOKEN empty to disable read-token access; see docs/auth.md.
READ_TOKEN=

# Per-IP fixed-window limits. Device telemetry counts as writes.
AUTH_FAILURE_LIMIT=10
WRITE_LIMIT=120
RATE_LIMIT_WINDOW_MS=60000

# --- Default room and team identity (seed only; runtime-editable via /api/settings) ---
DEFAULT_ROOM_ID=ROOM-1
TEAM_ID=Forever_Knights

# --- Safety notifications (Level 4) ---
# Nothing is sent unless a provider is fully configured. Supported values:
#   log       record only (default; no external delivery)
#   telegram  requires TELEGRAM_BOT_TOKEN + TELEGRAM_CHAT_ID
#   email     requires RESEND_API_KEY + NOTIFY_EMAIL_FROM + NOTIFY_EMAIL_TO
#   webhook   requires NOTIFY_WEBHOOK_URL (POSTs {text,...} JSON)
# Alerts are attempted for FIRE, PANIC and HEAT_DANGER within seconds and each
# attempt is recorded in notification_log with sent/skipped/failed status.
NOTIFY_PROVIDER=log
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
RESEND_API_KEY=
NOTIFY_EMAIL_FROM=
NOTIFY_EMAIL_TO=
NOTIFY_WEBHOOK_URL=
